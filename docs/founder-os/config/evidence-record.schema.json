{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://natural-nation-mvp.github.io/schemas/founder-os/evidence-record.schema.json",
  "title": "Founder OS Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "workspaceId",
    "eventType",
    "title",
    "projectImpact",
    "changedFiles",
    "decision",
    "outcome",
    "provider",
    "cost",
    "payloadHash",
    "repository",
    "occurredAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^EV-[0-9]{4,}$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "enum": [
        "run",
        "approval",
        "exception",
        "deployment",
        "record"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "projectImpact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "effect"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-required",
            "pending",
            "approved",
            "rejected",
            "changes-requested"
          ]
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "needs-review",
            "exception",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ready",
            "degraded",
            "unavailable",
            "manual"
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "const": "USD"
        }
      }
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "readOnly": true
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name",
        "ref",
        "commit"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "readOnly": true
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$",
          "readOnly": true
        }
      }
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "technicalProof": {
      "type": "object"
    }
  }
}
