{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fos://schemas/backlog-item.schema.json",
  "title": "Founder OS Workspace Backlog Item",
  "type": "object",
  "required": ["backlogId", "issueNumber", "issueUrl", "title", "status", "ownerRole", "approvalClass", "release", "nextAction", "evidenceRefs", "order"],
  "properties": {
    "backlogId": { "type": "string", "minLength": 1 },
    "issueNumber": { "type": "integer", "minimum": 1 },
    "issueUrl": { "type": "string", "pattern": "^https://github\\.com/" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planned", "ready", "in-progress", "blocked", "needs-reconciliation", "awaiting-founder", "verified", "complete"] },
    "ownerRole": { "type": "string", "minLength": 1 },
    "supportingRoles": { "type": "array", "items": { "type": "string" } },
    "approvalClass": { "enum": ["routine-review", "routine-review-founder-consequential", "approved-scope-founder-merge", "founder-protected", "prohibited"] },
    "release": {
      "type": "object",
      "required": ["target", "phase"],
      "properties": { "target": { "type": "string" }, "phase": { "type": "string" } },
      "additionalProperties": false
    },
    "nextAction": { "type": "string", "minLength": 1 },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "order": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
